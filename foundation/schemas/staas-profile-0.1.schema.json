{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "STaaS Business Strategy Profile 0.1.0",
  "description": "Validates STaaS profile metadata in parsed OKF v0.3 frontmatter. This is not a base OKF validator.",
  "type": "object",
  "required": ["type", "x-staas"],
  "properties": {
    "type": {
      "enum": ["Business Context", "Customer Segment", "Market Observation", "Evidence Claim", "Assumption", "Strategic Option", "Decision", "Experiment", "Metric", "Outcome", "Learning Concept", "Attested Computation"]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "x-staas": {
            "type": "object",
            "properties": {
              "access_basis": {"enum": ["public", "customer_provided", "licensed", "permissioned", "synthetic", "other"]},
              "redistribution": {"enum": ["permitted", "prohibited", "unknown"]},
              "terms_uri": {"type": "string"},
              "reviewed_at": {"type": "string", "format": "date-time"}
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "x-staas": {
      "type": "object",
      "required": ["profile_version", "id", "record_version"],
      "properties": {
        "profile_version": {"const": "0.1.0"},
        "id": {"type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"},
        "record_version": {"type": "integer", "minimum": 1},
        "confidence": {
          "type": "object",
          "required": ["value", "actor", "at", "scale"],
          "properties": {
            "value": {"type": "number", "minimum": 0, "maximum": 1},
            "actor": {"type": "string", "minLength": 1},
            "at": {"type": "string", "format": "date-time"},
            "scale": {"const": "subjective-belief"}
          },
          "additionalProperties": true
        },
        "impact": {"enum": ["low", "medium", "high"]},
        "uncertainty": {"enum": ["low", "medium", "high"]},
        "claim_kind": {"enum": ["observed_fact", "source_claim", "founder_assertion", "model_inference", "hypothesis"]},
        "review_state": {"enum": ["unreviewed", "human_reviewed", "disputed"]},
        "decision_state": {"enum": ["provisional", "approved", "deferred", "rejected"]},
        "selected_option_id": {"type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"},
        "execution_status": {"enum": ["planned", "running", "completed", "cancelled"]},
        "hypothesis": {"type": "string", "minLength": 1},
        "method": {"type": "string", "minLength": 1},
        "success_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "failure_criteria": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "learning_steps": {"type": "array", "uniqueItems": true, "items": {"enum": ["orient", "model", "contrast", "retrieve", "apply", "reflect", "revisit"]}}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
